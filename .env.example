# ─────────────────────────────────────────────────────────────
# Dnyanam — environment variables
# Copy this file to .env.local and fill in the values.
# The app boots in read-only DEMO MODE when Supabase is not set.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for Razorpay callback + absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API
# Either naming works: NEXT_PUBLIC_SUPABASE_ANON_KEY or the newer
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose the service-role key to the browser.
# Used for webhooks, pricing, order fulfilment and signed downloads.
# Either naming works: SUPABASE_SERVICE_ROLE_KEY or the newer
# SUPABASE_SECRET_KEY (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── Razorpay ─────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Webhooks — must match the secret configured there.
# Endpoint: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────
# Set to "true" only on trusted local/preview deployments to surface
# extra diagnostic messages in checkout errors.
# NEXT_PUBLIC_DEBUG_PAYMENTS=false
